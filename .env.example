# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.
#   macOS/Linux: cp .env.example .env
#   Windows:     copy .env.example .env

# Database profile: local = H2 in-memory (no install needed), dev = PostgreSQL
APP_PROFILE=local
SERVER_PORT=8080
LOG_FILE_PATH=logs/puppysupplyservice.log

# PostgreSQL settings (used when APP_PROFILE=dev)
DB_URL=jdbc:postgresql://localhost:5432/puppysupply
DB_USERNAME=changeme
DB_PASSWORD=changeme
# always = create tables and seed data on startup (idempotent), never = skip
DB_INIT_MODE=always

# H2 settings (used when APP_PROFILE=local)
H2_USERNAME=sa
H2_PASSWORD=
